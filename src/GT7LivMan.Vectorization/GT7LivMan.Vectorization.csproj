<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Most of this project is vendored 2016-era third-party source (ImageTracer/ — see its own
         LICENSE-ImageTracer.NET.txt), never annotated for nullable-reference-types and written
         with fully-qualified/explicit usings throughout — Nullable/ImplicitUsings stay off
         project-wide (rather than fought per-file) so it compiles close to as-is. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
